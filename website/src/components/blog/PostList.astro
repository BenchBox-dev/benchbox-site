---
import { excerptOf, formatBlogDate, postPath, type BlogPost } from "../../lib/blog.ts";

interface Props {
  posts: BlogPost[];
  excerpts?: boolean;
}

const { posts, excerpts = false } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <time datetime={post.date.toISOString().slice(0, 10)}>{formatBlogDate(post.date)}</time>
        {" - "}
        <a href={postPath(post)}>{post.title}</a>
        {excerpts && excerptOf(post.html) !== undefined && <p class="post-list__excerpt" set:html={excerptOf(post.html)} />}
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    padding-left: 0;
  }
  .post-list li {
    margin: 0.5rem 0;
  }
  .post-list__excerpt {
    margin: 0.25rem 0 0;
  }
</style>
