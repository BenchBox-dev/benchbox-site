---
import ResultSummary from "../../../layouts/ResultSummary.astro";
import { loadResultsSummary, reasonCounts, SUMMARY_ROOT } from "../../../lib/results-summary.ts";
import SummaryLabels from "../../../components/results/SummaryLabels.astro";

export async function getStaticPaths() {
  const { benchmarks } = await loadResultsSummary();
  return benchmarks.map((page) => ({ params: { id: page.id }, props: { page } }));
}

const { page } = Astro.props;
const citations = [...page.cohorts.flatMap((cohort) => cohort.ranked), ...page.excluded].flatMap((line) => (line.citation === null ? [] : [line.citation]));
const description = `${page.label} on BenchBox: ${page.resultCount} published ${page.resultCount === 1 ? "run" : "runs"} across ${page.platforms.length} ${page.platforms.length === 1 ? "platform" : "platforms"}.`;
---

<ResultSummary
  title={page.label}
  description={description}
  crumbs={[{ label: "Results", href: "/results/" }, { label: "Benchmark summaries", href: `${SUMMARY_ROOT}/benchmarks.html` }, { label: page.label }]}
  explorerHref={page.explorerHref}
  explorerLabel={`Open ${page.label} in the Results Explorer`}
>
  <p>{description} Latest run {page.latestRun.slice(0, 10)}.</p>

  <h2>Platforms</h2>
  <ul>
    {page.platforms.map((platform) => <li><a href={platform.summaryHref}>{platform.label}</a>, {platform.runCount} {platform.runCount === 1 ? "run" : "runs"}</li>)}
  </ul>

  <h2 id="score-definitions">Score definitions</h2>
  <dl>
    {page.scoreDefinitions.map((definition) => (
      <>
        <dt>{definition.label}</dt>
        <dd>{definition.meaning} Unit: {definition.unit}; {definition.direction}. <a href={definition.href}>Definition in the benchmark methodology</a>.</dd>
      </>
    ))}
  </dl>

  {page.cohorts.map((cohort) => (
    <>
      <h2>{cohort.scale}, {cohort.phase}</h2>
      <div class="result-summary__table">
        <table>
          <caption>Ranked by {cohort.metricLabel.toLowerCase()}</caption>
          <thead>
            <tr><th scope="col">Rank</th><th scope="col">Platform</th><th scope="col">Version</th><th scope="col">Run date</th><th scope="col">{cohort.metricLabel}</th><th scope="col">Geomean</th><th scope="col">Ranking</th><th scope="col">Execution environment</th><th scope="col">Tuning mode</th><th scope="col">Trust label</th></tr>
          </thead>
          <tbody>
            {cohort.ranked.map((line) => (
              <tr>
                <td>{line.rank ?? "—"}</td>
                <th scope="row"><a href={line.receiptHref}>{line.platformLabel}</a><SummaryLabels labels={line.corpusLabels} /></th>
                <td>{line.version ?? "—"}</td>
                <td>{line.runDate.slice(0, 10)}</td>
                <td>{line.score}</td>
                <td>{line.geomean}</td>
                <td>Ranked</td>
                <td>{line.environment}</td><td>{line.tuningMode}</td><td>{line.trustLabel}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}

  {page.excluded.length > 0 && (
    <>
      <h2 id="not-ranked">Runs not included in rankings</h2>
      <p>
        {page.excluded.length} {page.excluded.length === 1 ? "run is" : "runs are"} published with {page.excluded.length === 1 ? "its" : "their"} numbers and receipt but {page.excluded.length === 1 ? "is" : "are"} not ranked. Reason: {reasonCounts(page.excluded.map((line) => line.exclusion ?? "")).map((entry) => `${entry.reason} (${entry.count})`).join("; ")}
      </p>
      <div class="result-summary__table">
        <table>
          <caption>Runs excluded from ranking</caption>
          <thead>
            <tr><th scope="col">Scale</th><th scope="col">Phase</th><th scope="col">Platform</th><th scope="col">Version</th><th scope="col">Run date</th><th scope="col">Score</th><th scope="col">Geomean</th><th scope="col">Reason not ranked</th><th scope="col">Execution environment</th><th scope="col">Tuning mode</th><th scope="col">Trust label</th></tr>
          </thead>
          <tbody>
            {page.excluded.map((line) => (
              <tr>
                <td>{line.scale}</td>
                <td>{line.phase}</td>
                <th scope="row"><a href={line.receiptHref}>{line.platformLabel}</a><SummaryLabels labels={line.corpusLabels} /></th>
                <td>{line.version ?? "—"}</td>
                <td>{line.runDate.slice(0, 10)}</td>
                <td>{line.score}</td>
                <td>{line.geomean}</td>
                <td>{line.exclusion}</td>
                <td>{line.environment}</td><td>{line.tuningMode}</td><td>{line.trustLabel}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {citations.length > 0 && (
    <>
      <h2 id="cite">How to cite a run</h2>
      <p>Cite a run with its line below. The date is the day the page was built; replace it with the day you read the result.</p>
      <ul>
        {citations.map((citation) => <li>{citation}</li>)}
      </ul>
    </>
  )}
</ResultSummary>
