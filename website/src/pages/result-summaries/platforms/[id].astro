---
import ResultSummary from "../../../layouts/ResultSummary.astro";
import { loadResultsSummary, reasonCounts, SUMMARY_ROOT } from "../../../lib/results-summary.ts";

export async function getStaticPaths() {
  const { platforms } = await loadResultsSummary();
  return platforms.map((page) => ({ params: { id: page.id }, props: { page } }));
}

const { page } = Astro.props;
const description = `${page.label} on BenchBox: ${page.resultCount} published ${page.resultCount === 1 ? "run" : "runs"} across ${page.benchmarks.length} ${page.benchmarks.length === 1 ? "benchmark" : "benchmarks"}.`;
---

<ResultSummary
  title={page.label}
  description={description}
  crumbs={[{ label: "Results", href: "/results/" }, { label: "Platform summaries", href: `${SUMMARY_ROOT}/platforms.html` }, { label: page.label }]}
  explorerHref={page.explorerHref}
  explorerLabel={`Open ${page.label} in the Results Explorer`}
>
  <p>{description} Latest run {page.latestRun.slice(0, 10)}.</p>

  <h2>Benchmarks</h2>
  <ul>
    {page.benchmarks.map((benchmark) => <li><a href={benchmark.summaryHref}>{benchmark.label}</a>, {benchmark.runCount} {benchmark.runCount === 1 ? "run" : "runs"}</li>)}
  </ul>

  <h2>Ranked runs</h2>
  {page.ranked.length === 0 && <p>None of this platform's published runs is ranked.</p>}
  {page.ranked.length > 0 && (
  <div class="result-summary__table">
    <table>
      <thead>
        <tr><th scope="col">Benchmark</th><th scope="col">Scale</th><th scope="col">Phase</th><th scope="col">Version</th><th scope="col">Run date</th><th scope="col">Score</th><th scope="col">Geomean</th><th scope="col">Ranking</th></tr>
      </thead>
      <tbody>
        {page.ranked.map((run) => (
          <tr>
            <th scope="row"><a href={run.receiptHref}>{run.benchmarkLabel}</a></th>
            <td>{run.scale}</td>
            <td>{run.phase}</td>
            <td>{run.version ?? "—"}</td>
            <td>{run.runDate.slice(0, 10)}</td>
            <td title={run.metricLabel}>{run.score}</td>
            <td>{run.geomean}</td>
            <td>{run.rankingStatus}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  )}

  {page.excluded.length > 0 && (
    <>
      <h2 id="not-ranked">Runs not included in rankings</h2>
      <p>
        {page.excluded.length} {page.excluded.length === 1 ? "run is" : "runs are"} published with {page.excluded.length === 1 ? "its" : "their"} numbers and receipt but {page.excluded.length === 1 ? "is" : "are"} not ranked. Reason: {reasonCounts(page.excluded.map((run) => run.rankingStatus)).map((entry) => `${entry.reason} (${entry.count})`).join("; ")}
      </p>
      <div class="result-summary__table">
        <table>
      <thead>
        <tr><th scope="col">Benchmark</th><th scope="col">Scale</th><th scope="col">Phase</th><th scope="col">Version</th><th scope="col">Run date</th><th scope="col">Score</th><th scope="col">Geomean</th><th scope="col">Reason not ranked</th></tr>
      </thead>
      <tbody>
        {page.excluded.map((run) => (
          <tr>
            <th scope="row"><a href={run.receiptHref}>{run.benchmarkLabel}</a></th>
            <td>{run.scale}</td>
            <td>{run.phase}</td>
            <td>{run.version ?? "—"}</td>
            <td>{run.runDate.slice(0, 10)}</td>
            <td title={run.metricLabel}>{run.score}</td>
            <td>{run.geomean}</td>
            <td>{run.rankingStatus}</td>
          </tr>
        ))}
      </tbody>
        </table>
      </div>
    </>
  )}
</ResultSummary>
